.ccard input,.ccard select{background:rgba(255,255,255,.95)}
.grid4{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
table{width:100%;border-collapse:collapse}
th{font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:#78a0b5;text-align:left;padding:8px;border-bottom:1px solid #e4f0f6}
td{padding:9px 8px;border-bottom:1px solid #eef6fa;font-size:13px}
tr:hover td{background:#f7fcff}
.code{font-family:ui-monospace,Consolas,monospace;font-weight:800;letter-spacing:1px}
.tabs{display:flex;gap:6px;margin-bottom:12px;flex-wrap:wrap}
.tab{padding:7px 14px;border-radius:99px;background:#eef6fa;color:#4b7d94;font-weight:700;font-size:12px;cursor:pointer}
.tab.active{background:#2596d1;color:#fff}
.legend{font-size:11px;color:#6b93a8;margin-top:6px}
.dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin:0 4px 0 10px}
.dot.g{background:#7cc74f}.dot.b{background:#3aa4d8}
canvas{width:100%}
.toast{position:fixed;left:50%;bottom:26px;transform:translateX(-50%) translateY(80px);background:#123c52;color:#fff;padding:11px 20px;border-radius:99px;font-weight:600;font-size:13px;opacity:0;transition:.25s;z-index:99;box-shadow:0 8px 26px rgba(0,0,0,.25)}
.toast.show{opacity:1;transform:translateX(-50%) translateY(0)}
.toast.bad{background:#c04747}
.note{font-size:12px;color:#6b93a8;margin-top:8px;line-height:1.5}
.inline{display:flex;gap:8px;align-items:end;flex-wrap:wrap}
.inline .fld{flex:1;min-width:130px;margin-bottom:0}
</style>
</head>
<body>

<div id="loginWrap">
	<div class="login-card">
		<div class="brandmark">&#128246;</div>
		<h1 id="liBrand">SHAMIM WiFi</h1>
		<div class="sub">Sign in to manage your SHAMIM WiFi Zone</div>
		<div class="fld"><label>Router ID</label><input id="liId" placeholder="admin"></div>
		<div class="fld"><label>Password</label><input id="liPw" type="password" placeholder="********" onkeydown="if(event.key==='Enter')doLogin()"></div>
		<button class="btn wide" onclick="doLogin()">Sign In</button>
		<div class="err" id="liErr"></div>
	</div>
</div>

<div id="app">
<div class="sidebar" style="overflow-y:auto">
	<div class="side-brand"><span class="bm">&#128246;</span> <span id="brandName">SHAMIM WiFi</span></div>
	<div class="mgroup">Core Monitor</div>
	<div class="mitem active" data-pg="dash" onclick="nav('dash')">&#128200; Dashboard</div>
	<div class="mitem" data-pg="users" onclick="nav('users')">&#128101; Active Users</div>
	<div class="mgroup">Voucher Operations</div>
	<div class="mitem" data-pg="vouchers" onclick="nav('vouchers')">&#127915; Vouchers</div>
	<div class="mitem" data-pg="packages" onclick="nav('packages')">&#128230; Voucher Package</div>
	<div class="mitem" data-pg="insights" onclick="nav('insights')">&#128202; Insights</div>
	<div class="mgroup">System &amp; Finance</div>
	<div class="mitem" data-pg="deposit" onclick="nav('deposit')">&#128179; Deposit &amp; Balance</div>
	<div class="mitem" data-pg="theme" onclick="nav('theme')">&#127912; Portal Theme</div>
	<div class="mitem" data-pg="telegram" onclick="nav('telegram')">&#128172; Telegram Bot</div>
	<div class="mitem" data-pg="payment" onclick="nav('payment')">&#128181; Payment Integration</div>
	<div class="mitem" data-pg="account" onclick="nav('account')">&#128100; Account</div>
	<div class="mitem" data-pg="update" onclick="nav('update')">&#128260; Check Update</div>
	<div class="mitem" data-pg="wl" onclick="nav('wl')">&#128737; Bridge Mode</div>
	<div class="mitem" data-pg="reset" onclick="nav('reset')">&#128683; Reset MAC</div>
	<div class="mitem" data-pg="settings" onclick="nav('settings')">&#9881; Settings</div>
	<div class="mitem logout" onclick="doLogout()">&#128682; Logout Admin</div>
</div>
<div class="main">

<div class="page show" id="pg-dash">
	<div class="pagehead"><div><h1>System Monitor</h1><div class="desc">Real-time status and operational overview</div></div><span class="badge-on" id="routerBadge">&#9679; ROUTER ONLINE</span></div>
	<div class="stats">
		<div class="stat blue"><div class="stat-t">TOTAL VOUCHERS</div><div class="stat-v" id="stTotal">0</div><div><span class="chip w" id="chipA">Active: 0</span><span class="chip w" id="chipU">Unused: 0</span></div></div>
		<div class="stat green"><div class="stat-t">ACTIVE VOUCHERS</div><div class="stat-v" id="stActive">0</div><div class="stat-s">running right now</div></div>
		<div class="stat orange"><div class="stat-t">CONNECTED NOW</div><div class="stat-v" id="stConn">0</div><div class="stat-s">live devices on hotspot</div></div>
		<div class="stat yellow"><div class="stat-t">UNUSED CODES</div><div class="stat-v" id="stUnused">0</div><div class="stat-s" id="stExpiredS">used/expired: 0</div></div>
	</div>
	<div class="card"><h3>&#128225; Bandwidth Monitoring <span class="muted">live LAN traffic</span></h3><canvas id="bwCanvas" height="170"></canvas><div class="legend"><span class="dot g"></span>Download <span class="dot b"></span>Upload</div></div>
	<div class="card"><h3>&#128246; Connected Devices <button class="btn sm ghost" onclick="refreshDashDev()">&#8635; Refresh</button></h3><div id="dashDev"></div></div>
</div>

<div class="page" id="pg-users">
	<div class="pagehead"><div><h1>Active Sessions</h1><div class="desc">Real-time status of current active sessions connected to your hotspot network</div></div><span class="badge-on" id="userCount">TOTAL CONNECTED: 0</span></div>
	<div class="card"><h3>&#128101; Active Devices <button class="btn sm ghost" onclick="loadUsers()">&#8635; Refresh</button></h3><div id="userTable"></div></div>
</div>

<div class="page" id="pg-vouchers">
	<div class="pagehead"><div><h1>Voucher Management</h1><div class="desc">Generate, print, and keep track of internet access vouchers</div></div><button class="btn green" onclick="printUnused()">&#128424; Print Unused</button></div>
	<div class="two">
		<div class="ccard orange">
			<h3>&#9999; Manual Creation</h3>
			<div id="pkQuick" style="margin-bottom:8px"></div>
			<div class="fld"><label>Custom Voucher Code (9 chars, empty = auto)</label><input id="mcCode" maxlength="9" placeholder="E.G. NET500MB1" style="text-transform:uppercase"></div>
			<div class="fld"><label>Price (Tk, for earnings &amp; printed card)</label><input id="mcP" type="number" min="0" value="0"></div>
			<div class="grid4">
				<div class="fld"><label>Days</label><input id="mcD" type="number" min="0" value="1"></div>
				<div class="fld"><label>Hrs</label><input id="mcH" type="number" min="0" value="0"></div>
				<div class="fld"><label>Mins</label><input id="mcM" type="number" min="0" value="0"></div>
				<div class="fld"><label>Speed Limit</label><select id="mcS"></select></div>
			</div>
			<div style="margin-top:12px"><button class="btn wide" style="background:rgba(255,255,255,.22)" onclick="createOne()">&#10133; CREATE SINGLE VOUCHER</button></div>
		</div>
		<div class="ccard blue">
			<h3>&#128218; Bulk Generation</h3>
			<div class="fld"><label>Quantity (1 - 1000)</label><input id="bkQ" type="number" min="1" max="1000" value="10"></div>
			<div class="fld"><label>Price per Voucher (Tk)</label><input id="bkP" type="number" min="0" value="0"></div>
			<div class="grid4">
				<div class="fld"><label>Days</label><input id="bkD" type="number" min="0" value="7"></div>
				<div class="fld"><label>Hrs</label><input id="bkH" type="number" min="0" value="0"></div>
				<div class="fld"><label>Mins</label><input id="bkM" type="number" min="0" value="0"></div>
				<div class="fld"><label>Speed Limit</label><select id="bkS"></select></div>
			</div>
			<div style="margin-top:12px"><button class="btn wide" style="background:rgba(255,255,255,.22)" onclick="createBulk()">&#10024; GENERATE VOUCHER BATCH</button></div>
		</div>
	</div>
	<div class="card">
		<h3>All Vouchers <span class="inline" style="gap:6px"><input id="vPrice" placeholder="Price on card e.g. Tk 20" style="width:170px"><button class="btn sm ghost" onclick="loadVouchers()">&#8635; Refresh</button></span></h3>
		<div class="tabs">
			<div class="tab active" data-t="all" onclick="setTab('all')">All Vouchers</div>
			<div class="tab" data-t="active" onclick="setTab('active')">Active Hotspots</div>
			<div class="tab" data-t="unused" onclick="setTab('unused')">Unused Codes</div>
			<div class="tab" data-t="used" onclick="setTab('used')">Used / Expired</div>
		</div>
		<div id="vTable"></div>
	</div>
</div>

<div class="page" id="pg-reset">
	<div class="pagehead"><div><h1>Reset Voucher MAC</h1><div class="desc">De-authorize a voucher so it can be used again on any other device</div></div></div>
	<div class="card" style="max-width:430px">
		<h3>&#128260; Reset Voucher Code</h3>
		<div class="fld"><label>Voucher Code *</label><input id="rsCode" maxlength="9" placeholder="E.G. A182C3XYZ" style="text-transform:uppercase"></div>
		<button class="btn blue wide" onclick="resetVoucher()">&#128260; RESET DEVICE MAC</button>
		<div class="note">This marks the code as fresh/unused again. The customer can enter it on a new device. If the old device is still connected, also remove it from Active Users.</div>
	</div>
</div>

<div class="page" id="pg-wl">
	<div class="pagehead"><div><h1>Bridge Mode Whitelist</h1><div class="desc">Whitelist client MAC addresses to bypass the captive portal with unlimited speed and lifetime validity</div></div></div>
	<div class="two">
		<div class="card">
			<h3>&#128737; Whitelist New Device</h3>
			<div class="fld"><label>MAC Address *</label><input id="wlMac" placeholder="E.G. AA:BB:CC:DD:EE:FF"></div>
			<button class="btn blue wide" onclick="wlAdd()">&#128246; CONNECT DEVICE</button>
			<div class="note">Find a device MAC in Active Users, or in the phone WiFi settings.</div>
		</div>
		<div class="card"><h3>&#128203; Whitelisted Devices <button class="btn sm ghost" onclick="loadWl()">&#8635;</button></h3><div id="wlTable"></div></div>
	</div>
</div>

<div class="page" id="pg-packages">
	<div class="pagehead"><div><h1>Voucher Package</h1><div class="desc">Create ready-made packages (name, price, speed, validity) for one-click voucher creation</div></div></div>
	<div class="two">
		<div class="card">
			<h3>&#128230; New Package</h3>
			<div class="fld"><label>Package Name *</label><input id="pkName" maxlength="24" placeholder="E.G. 3 Days 10Mbps"></div>
			<div class="fld"><label>Price (Tk) *</label><input id="pkPrice" type="number" min="0" value="20"></div>
			<div class="grid4">
				<div class="fld"><label>Days</label><input id="pkD" type="number" min="0" value="3"></div>
				<div class="fld"><label>Hrs</label><input id="pkH" type="number" min="0" value="0"></div>
				<div class="fld"><label>Mins</label><input id="pkM" type="number" min="0" value="0"></div>
				<div class="fld"><label>Speed Limit</label><select id="pkS"></select></div>
			</div>
			<div style="margin-top:12px"><button class="btn blue wide" onclick="pkAdd()">&#10133; ADD PACKAGE</button></div>
			<div class="note">Packages show as one-click buttons on the Vouchers page, and will appear on the customer portal in the portal update.</div>
		</div>
		<div class="card"><h3>&#128203; All Packages <button class="btn sm ghost" onclick="loadPk()">&#8635;</button></h3><div id="pkTable"></div></div>
	</div>
</div>

<div class="page" id="pg-insights">
	<div class="pagehead"><div><h1>Insights</h1><div class="desc">Earnings and sales overview of your hotspot business</div></div></div>
	<div class="stats">
		<div class="stat green"><div class="stat-t">TOTAL EARNINGS</div><div class="stat-v" id="inTotal">Tk 0</div><div class="stat-s">from used vouchers</div></div>
		<div class="stat blue"><div class="stat-t">LAST 7 DAYS</div><div class="stat-v" id="in7">Tk 0</div><div class="stat-s">weekly earnings</div></div>
		<div class="stat orange"><div class="stat-t">LAST 30 DAYS</div><div class="stat-v" id="in30">Tk 0</div><div class="stat-s">monthly earnings</div></div>
		<div class="stat yellow"><div class="stat-t">VOUCHERS SOLD</div><div class="stat-v" id="inUsed">0</div><div class="stat-s">codes used by customers</div></div>
	</div>
	<div class="card"><h3>&#129297; Recent Sales <button class="btn sm ghost" onclick="loadInsights()">&#8635;</button></h3><div id="inTable"></div>
	<div class="note">A sale is counted when a customer uses a voucher that was created with a price. Set the price when creating vouchers.</div></div>
</div>

<div class="page" id="pg-deposit">
	<div class="pagehead"><div><h1>Deposit &amp; Balance</h1><div class="desc">Account balance and billing for this panel</div></div></div>
	<div class="stats">
		<div class="stat green"><div class="stat-t">PANEL FEE</div><div class="stat-v">Tk 0</div><div class="stat-s">forever - self hosted</div></div>
		<div class="stat blue"><div class="stat-t">DEPOSIT NEEDED</div><div class="stat-v">None</div><div class="stat-s">no balance system</div></div>
		<div class="stat orange"><div class="stat-t">YOUR EARNINGS</div><div class="stat-v" id="depEarn">Tk 0</div><div class="stat-s">see Insights for details</div></div>
	</div>
	<div class="card"><h3>&#127881; 100% Free Panel</h3>
	<div class="note">This panel runs on your own router, so there is no monthly fee, no deposit and no balance - unlike SaaS providers. Everything you earn is yours.</div></div>
</div>

<div class="page" id="pg-theme">
	<div class="pagehead"><div><h1>Portal Theme</h1><div class="desc">Customize what customers see on the WiFi login portal</div></div></div>
	<div class="card" style="max-width:520px">
		<h3>&#127912; Portal Settings</h3>
		<div class="fld"><label>Portal Welcome Message (English)</label><input id="thMsg" maxlength="120" placeholder="Welcome to SHAMIM WiFi - Buy a voucher to get online"></div>
		<button class="btn blue wide" onclick="themeSave()">&#128190; SAVE PORTAL THEME</button>
		<div class="note">Brand name is set in Settings. The message is stored now and gets applied to the customer portal page in the portal update (next phase).</div>
	</div>
</div>

<div class="page" id="pg-telegram">
	<div class="pagehead"><div><h1>Telegram Bot</h1><div class="desc">Get panel notifications in your Telegram</div></div></div>
	<div class="card" style="max-width:520px">
		<h3>&#128172; Bot Configuration</h3>
		<div class="fld"><label>Bot Token (from @BotFather)</label><input id="tgToken" placeholder="123456789:AAAA..."></div>
		<div class="fld"><label>Chat ID (from @userinfobot)</label><input id="tgChat" placeholder="123456789"></div>
		<div class="inline">
			<button class="btn blue" onclick="tgSave()">&#128190; SAVE</button>
			<button class="btn green" onclick="tgTest()">&#128228; SEND TEST MESSAGE</button>
		</div>
		<div class="note">In Telegram, message @BotFather and send /newbot to create a bot, copy its token. Then message @userinfobot to get your Chat ID. Router must have internet.</div>
	</div>
</div>

<div class="page" id="pg-payment">
	<div class="pagehead"><div><h1>Payment Integration</h1><div class="desc">Configure hotspot payment channels shown to customers</div></div></div>
	<div class="card" style="max-width:520px">
		<h3>&#128181; Manual Payment (bKash / Nagad)</h3>
		<div class="inline">
			<div class="fld"><label>bKash Number (Personal)</label><input id="pyBkash" placeholder="01XXXXXXXXX"></div>
			<div class="fld"><label>Nagad Number (Personal)</label><input id="pyNagad" placeholder="01XXXXXXXXX"></div>
		</div>
		<div class="fld"><label>Instruction Note (English)</label><input id="pyNote" maxlength="120" placeholder="Send money then SMS the TrxID to 01XXXXXXXXX"></div>
		<button class="btn blue wide" onclick="paySave()">&#128190; SAVE PAYMENT SETTINGS</button>
		<div class="note">These numbers are stored now and will show on the customer portal in the portal update. Automatic bKash/Nagad API verification needs a merchant account - manual send-money + TrxID works for everyone.</div>
	</div>
</div>

<div class="page" id="pg-account">
	<div class="pagehead"><div><h1>Account</h1><div class="desc">Admin login credentials for this panel</div></div></div>
	<div class="card" style="max-width:520px"><h3>&#128273; Admin Credentials</h3>
		<div class="inline">
			<div class="fld"><label>New Router ID</label><input id="cpId"></div>
			<div class="fld"><label>New Password (min 6)</label><input id="cpPw" type="password"></div>
		</div>
		<button class="btn red" onclick="chPass()">&#128273; CHANGE LOGIN</button>
		<div class="note">After changing, you will be signed out and must log in with the new ID and password.</div>
	</div>
</div>

<div class="page" id="pg-update">
	<div class="pagehead"><div><h1>Check Update</h1><div class="desc">Panel version information</div></div></div>
	<div class="card" style="max-width:430px">
		<h3>&#128260; SHAMIM WiFi Panel</h3>
		<div class="stat blue" style="margin:10px 0"><div class="stat-t">CURRENT VERSION</div><div class="stat-v" id="upVer">v1.1</div></div>
		<button class="btn blue wide" onclick="toast('You are running the latest version')">&#128260; CHECK FOR UPDATES</button>
		<div class="note">Updates are installed by replacing the file /www/cgi-bin/shamim with a newer version - your vouchers, packages and settings are kept.</div>
	</div>
</div>

<div class="page" id="pg-settings">
	<div class="pagehead"><div><h1>System Settings</h1><div class="desc">Configure system backup, auto reboot and hardware control actions</div></div></div>
	<div class="card"><h3>&#128295; Hardware Control Actions</h3>
		<button class="btn blue" onclick="rebootNow()">&#128268; REBOOT SYSTEM</button>
		<button class="btn orange" onclick="restartNds()">&#128260; RESTART PORTAL (openNDS)</button>
		<button class="btn red" onclick="factoryReset()">&#9888; FACTORY RESET ROUTER</button>
	</div>
	<div class="card"><h3>&#128190; Data Management Tools</h3>
		<button class="btn blue" onclick="window.open(API+'?action=backup')">&#11015; DOWNLOAD BACKUP</button>
		<div class="note">Backup contains the full voucher roll (vouchers.txt).</div>
		<div class="fld" style="margin-top:10px"><label>Restore: paste backup content here</label><textarea id="rsData" rows="4" placeholder="CODE12345,0,0,0,0,1440,0"></textarea></div>
		<button class="btn green" onclick="restoreData()">&#11014; RESTORE DATA</button>
	</div>
	<div class="card"><h3>&#127912; Brand &amp; Network</h3>
		<div class="inline">
			<div class="fld"><label>Brand Name</label><input id="cfBrand"></div>
			<div class="fld"><label>LAN Interface</label><input id="cfIf" placeholder="br-lan"></div>
			<button class="btn" onclick="saveCfg()">SAVE</button>
		</div>
	</div>
	<div class="card"><h3>&#9200; Schedule Auto Reboot Configuration</h3>
		<div class="inline">
			<div class="fld"><label>Schedule Type</label><select id="rbType"><option value="disabled">Disabled</option><option value="daily">Daily</option></select></div>
			<div class="fld"><label>Hour (0-23)</label><input id="rbHH" type="number" min="0" max="23" value="4"></div>
			<div class="fld"><label>Minute (0-59)</label><input id="rbMM" type="number" min="0" max="59" value="0"></div>
			<button class="btn blue" onclick="cronSave()">SAVE REBOOT SCHEDULE</button>
		</div>
		<div class="note">Set auto reboot schedule for best router performance.</div>
	</div>
</div>

</div>
</div>
<div class="toast" id="toast"></div>
<script>
var API = location.pathname;
var BRAND = 'SHAMIM WiFi';
function $(i){return document.getElementById(i);}
function toast(m,bad){var t=$('toast');t.textContent=m;t.className='toast show'+(bad?' bad':'');setTimeout(function(){t.className='toast';},3200);}

function api(a,d){
	var body=new URLSearchParams(d||{}).toString();
	return fetch(API+'?action='+a,{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:body})
	.then(function(r){return r.json();})
	.then(function(j){ if(j&&j.auth){showLogin();throw new Error('auth');} return j; });
}

/* ---------- login ---------- */
function showLogin(){ stopTimers(); $('loginWrap').style.display='flex'; $('app').style.display='none'; }
function showApp(){ $('loginWrap').style.display='none'; $('app').style.display='block'; nav('dash'); }
function doLogin(){
	fetch(API+'?action=login',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({id:$('liId').value,pw:$('liPw').value}).toString()})
	.then(function(r){return r.json();})
	.then(function(j){ if(j.ok){$('liErr').textContent='';showApp();} else {$('liErr').textContent=j.err||'Login failed';} })
	.catch(function(){ $('liErr').textContent='Cannot reach router'; });
}
function doLogout(){ api('logout').then(function(){ showLogin(); }); }
function boot(){
	fetch(API+'?action=stats',{method:'POST'}).then(function(r){return r.json();})
	.then(function(j){ if(j.ok){applyBrand(j);showApp();} else showLogin(); })
	.catch(function(){ showLogin(); });
}
function applyBrand(s){ if(s.brand){ BRAND=s.brand; $('brandName').textContent=s.brand; $('liBrand').textContent=s.brand; document.title=s.brand+' - Admin Panel'; } }

/* ---------- nav / timers ---------- */
var timers=[];
function stopTimers(){ timers.forEach(clearInterval); timers=[]; }
function nav(p){
	stopTimers();
	var items=document.querySelectorAll('.mitem');
	for(var i=0;i<items.length;i++){ items[i].className=items[i].className.replace(' active','');
		if(items[i].getAttribute('data-pg')===p) items[i].className+=' active'; }
	var pages=document.querySelectorAll('.page');
	for(var j=0;j<pages.length;j++) pages[j].className='page';
	$('pg-'+p).className='page show';
	if(p==='dash') loadDash();
	if(p==='users'){ loadUsers(); timers.push(setInterval(loadUsers,5000)); }
	if(p==='vouchers'){ loadVouchers(); api('pk_list').then(function(j){PKDATA=j.p||[];fillPkQuick();}); }
	if(p==='wl') loadWl();
	if(p==='settings') loadSettings();
	if(p==='packages') loadPk();
	if(p==='insights') loadInsights();
	if(p==='deposit') loadDeposit();
	if(p==='theme'||p==='telegram'||p==='payment'||p==='update') loadCfgPages();
}

/* ---------- format helpers ---------- */
function fmtSpeed(k){ k=+k; if(!k) return 'Unlimited'; return k>=1000 ? (k/1000)+' Mbps' : k+' kb/s'; }
function fmtDur(m){ m=+m; var d=Math.floor(m/1440),h=Math.floor((m%1440)/60),mm=m%60,s='';
	if(d)s+=d+'d '; if(h)s+=h+'h '; if(mm)s+=mm+'m'; return s.trim()||'0m'; }
function fmtRemain(sec){ if(sec<0)sec=0; var d=Math.floor(sec/86400),h=Math.floor((sec%86400)/3600),m=Math.floor((sec%3600)/60);
	if(d) return d+'d '+h+'h left'; if(h) return h+'h '+m+'m left'; return m+'m left'; }
function fmtBytes(b){ b=+b||0; if(b>1073741824) return (b/1073741824).toFixed(2)+' GB'; if(b>1048576) return (b/1048576).toFixed(1)+' MB'; if(b>1024) return (b/1024).toFixed(0)+' kB'; return b+' B'; }
function esc(s){ return String(s==null?'':s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

var SPEEDS=[[0,'Unlimited'],[2000,'2 Mbps'],[5000,'5 Mbps'],[10000,'10 Mbps'],[15000,'15 Mbps'],[20000,'20 Mbps'],[30000,'30 Mbps'],[50000,'50 Mbps']];
function fillSpeeds(){ ['mcS','bkS','pkS'].forEach(function(id){ var el=$(id),h='';
	SPEEDS.forEach(function(s){ h+='<option value="'+s[0]+'">'+s[1]+'</option>'; }); el.innerHTML=h; }); }

