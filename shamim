/* ---------- vouchers ---------- */
var VDATA=[],VNOW=0,VTAB='all';
function loadVouchers(){
	api('vlist').then(function(j){ VDATA=j.v||[]; VNOW=j.now; renderV(); });
}
function setTab(t){ VTAB=t;
	var tabs=document.querySelectorAll('.tab');
	for(var i=0;i<tabs.length;i++) tabs[i].className='tab'+(tabs[i].getAttribute('data-t')===t?' active':'');
	renderV();
}
function vstat(v){
	if(+v[6]===0) return ['unused','Unused','chip blue'];
	var exp=+v[6]+v[5]*60;
	if(VNOW<exp) return ['active','Active &#8226; '+fmtRemain(exp-VNOW),'chip green'];
	return ['used','Used / Expired','chip gray'];
}
function renderV(){
	var rows='',n=0;
	VDATA.forEach(function(v){
		var st=vstat(v);
		if(VTAB!=='all'&&st[0]!==VTAB) return;
		n++;
		rows+='<tr><td>'+n+'</td><td class="code">'+esc(v[0])+'</td><td>'+fmtSpeed(v[1])+'</td><td>'+fmtDur(v[5])+'</td><td><span class="'+st[2]+'">'+st[1]+'</span></td>'+
		'<td><button class="btn sm ghost" onclick="printCodes([\''+esc(v[0])+'\'])">&#128424;</button> '+
		'<button class="btn sm yellow" onclick="resetOne(\''+esc(v[0])+'\')">Reset</button> '+
		'<button class="btn sm red" onclick="delOne(\''+esc(v[0])+'\')">&#10005;</button></td></tr>';
	});
	$('vTable').innerHTML = n? '<table><tr><th>#</th><th>Code</th><th>Speed</th><th>Validity</th><th>Status</th><th>Actions</th></tr>'+rows+'</table>'
		: '<div class="note" style="text-align:center;padding:20px">No vouchers found in this tab.</div>';
}
function mins3(d,h,m){ return (+($(d).value)||0)*1440 + (+($(h).value)||0)*60 + (+($(m).value)||0); }
function createOne(){
	var mins=mins3('mcD','mcH','mcM');
