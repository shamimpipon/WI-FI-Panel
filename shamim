#!/bin/sh
# =========================================================
#  SHAMIM WiFi - Hotspot Voucher Admin Panel (v1.0)
#  Single-file CGI for OpenWrt (uhttpd) + openNDS theme_voucher
#  Install:  /www/cgi-bin/shamim   (chmod 755)
#  Open:     http://192.168.1.1/cgi-bin/shamim
#  Default login: admin / shamim123  (change in Settings!)
# =========================================================

CFGDIR="${SHAMIM_CFGDIR:-/etc/shamim}"
CFG="$CFGDIR/config"
VFILE="${SHAMIM_VFILE:-/etc/opennds/vouchers.txt}"
SESSFILE="${SHAMIM_SESS:-/tmp/shamim_sessions}"

mkdir -p "$CFGDIR" 2>/dev/null
if [ ! -f "$CFG" ]; then
	{
	printf 'ADMIN_ID=admin\n'
	printf 'ADMIN_PW=shamim123\n'
	printf 'LANIF=br-lan\n'
	printf 'BRAND="SHAMIM WiFi"\n'
	} > "$CFG"
fi
. "$CFG"
[ -n "$LANIF" ] || LANIF="br-lan"
[ -n "$BRAND" ] || BRAND="SHAMIM WiFi"
[ -n "$RB_TYPE" ] || RB_TYPE="disabled"
[ -n "$RB_HH" ] || RB_HH=4
[ -n "$RB_MM" ] || RB_MM=0
VERSION="1.1"
PKFILE="$CFGDIR/packages.txt"
PRFILE="$CFGDIR/prices.txt"
CRONF="${SHAMIM_CRON:-/etc/crontabs/root}"
touch "$PKFILE" "$PRFILE" 2>/dev/null
if [ ! -f "$VFILE" ]; then
	mkdir -p "$(dirname "$VFILE")" 2>/dev/null
	: > "$VFILE"
fi
touch "$SESSFILE" 2>/dev/null

# ---------- helpers ----------
urldecode() {
	printf '%b' "$(printf '%s' "$1" | sed -e 's/+/ /g' -e 's/%\([0-9A-Fa-f][0-9A-Fa-f]\)/\\x\1/g')"
}

BODY=""
if [ "$REQUEST_METHOD" = "POST" ] && [ -n "$CONTENT_LENGTH" ] && [ "$CONTENT_LENGTH" -gt 0 ] 2>/dev/null; then
	BODY=$(head -c "$CONTENT_LENGTH")
fi

param() {
	_v=$(printf '%s&%s' "$QUERY_STRING" "$BODY" | tr '&' '\n' | grep "^$1=" | head -n1 | cut -d= -f2-)
	urldecode "$_v"
}

jesc() { printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'; }
write_cfg() {
	{
	printf 'ADMIN_ID=%s\n' "$ADMIN_ID"
	printf 'ADMIN_PW=%s\n' "$ADMIN_PW"
	printf 'LANIF=%s\n' "$LANIF"
	printf 'BRAND="%s"\n' "$BRAND"
	printf 'TG_TOKEN="%s"\n' "$TG_TOKEN"
	printf 'TG_CHAT="%s"\n' "$TG_CHAT"
	printf 'PAY_BKASH="%s"\n' "$PAY_BKASH"
	printf 'PAY_NAGAD="%s"\n' "$PAY_NAGAD"
	printf 'PAY_NOTE="%s"\n' "$PAY_NOTE"
	printf 'PORTAL_MSG="%s"\n' "$PORTAL_MSG"
	printf 'RB_TYPE=%s\n' "$RB_TYPE"
	printf 'RB_HH=%s\n' "$RB_HH"
	printf 'RB_MM=%s\n' "$RB_MM"
	} > "$CFG"
}
jhdr() { printf 'Content-type: application/json\r\n\r\n'; }
err() { jhdr; printf '{"ok":0,"err":"%s"}' "$(jesc "$1")"; exit 0; }
okj() { jhdr; printf '{"ok":1}'; exit 0; }

is_mac()  { printf '%s' "$1" | grep -qE '^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$'; }
is_num()  { printf '%s' "$1" | grep -qE '^[0-9]+$'; }
is_code() { printf '%s' "$1" | grep -qE '^[A-Za-z0-9-]{9}$'; }
gencode() { tr -dc 'A-HJ-NP-Z2-9' < /dev/urandom | head -c 9; }
mktoken() { tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 32; }

COOKIE_TOKEN=$(printf '%s' "$HTTP_COOKIE" | tr ';' '\n' | sed 's/^ *//' | grep '^SHSESS=' | head -n1 | cut -d= -f2)
is_auth() { [ -n "$COOKIE_TOKEN" ] && grep -q "^$COOKIE_TOKEN$" "$SESSFILE" 2>/dev/null; }

ACTION=$(param action)

if [ -n "$ACTION" ] && [ "$ACTION" != "login" ] && ! is_auth; then
	jhdr; printf '{"ok":0,"auth":1,"err":"Not logged in"}'; exit 0
fi

case "$ACTION" in

login)
	ID=$(param id); PW=$(param pw)
	if [ -n "$ID" ] && [ "$ID" = "$ADMIN_ID" ] && [ "$PW" = "$ADMIN_PW" ]; then
		TOK=$(mktoken)
		printf '%s\n' "$TOK" >> "$SESSFILE"
		printf 'Content-type: application/json\r\nSet-Cookie: SHSESS=%s; Path=/; HttpOnly\r\n\r\n{"ok":1}' "$TOK"
	else
		sleep 1
		jhdr; printf '{"ok":0,"err":"Wrong Router ID or Password"}'
	fi
	exit 0;;

logout)
	[ -n "$COOKIE_TOKEN" ] && sed -i "/^$COOKIE_TOKEN\$/d" "$SESSFILE" 2>/dev/null
	okj;;

stats)
	NOW=$(date +%s)
	COUNTS=$(awk -F',' -v now="$NOW" 'NF>=7{t++; if($7==0){u++} else if(now < ($7+$6*60)){a++} else {x++}} END{printf "%d %d %d %d", t+0,u+0,a+0,x+0}' "$VFILE")
	T=$(printf '%s' "$COUNTS" | cut -d' ' -f1)
	U=$(printf '%s' "$COUNTS" | cut -d' ' -f2)
	A=$(printf '%s' "$COUNTS" | cut -d' ' -f3)
	X=$(printf '%s' "$COUNTS" | cut -d' ' -f4)
	UPT=$(cut -d. -f1 /proc/uptime 2>/dev/null)
	jhdr
	printf '{"ok":1,"total":%s,"unused":%s,"active":%s,"expired":%s,"now":%s,"uptime":%s,"brand":"%s","lanif":"%s"}' \
		"${T:-0}" "${U:-0}" "${A:-0}" "${X:-0}" "$NOW" "${UPT:-0}" "$(jesc "$BRAND")" "$(jesc "$LANIF")"
	exit 0;;

vlist)
	NOW=$(date +%s)
	jhdr
	printf '{"ok":1,"now":%s,"v":[' "$NOW"
	awk -F',' 'NF>=7 && $1!="" {printf "%s[\"%s\",%d,%d,%d,%d,%d,%d]", (c++?",":""), $1,$2,$3,$4,$5,$6,$7}' "$VFILE"
	printf ']}'
	exit 0;;

vcreate)
	CODE=$(param code | tr 'a-z' 'A-Z' | tr -d ' ')
	DOWN=$(param down); UP=$(param up); MINS=$(param mins)
	[ -z "$CODE" ] && CODE=$(gencode)
	is_code "$CODE" || err "Code must be exactly 9 letters/numbers (or leave empty for auto)"
	is_num "$DOWN" || DOWN=0
	is_num "$UP" || UP=0
	is_num "$MINS" || err "Validity minutes required"
	[ "$MINS" -gt 0 ] || err "Validity must be more than 0 minutes"
	grep -q "^$CODE," "$VFILE" && err "This code already exists"
	printf '%s,%s,%s,0,0,%s,0\n' "$CODE" "$DOWN" "$UP" "$MINS" >> "$VFILE"
	PRICE=$(param price)
	if is_num "$PRICE" && [ "$PRICE" -gt 0 ]; then printf '%s,%s\n' "$CODE" "$PRICE" >> "$PRFILE"; fi
	jhdr; printf '{"ok":1,"codes":["%s"]}' "$CODE"
	exit 0;;

vbulk)
	QTY=$(param qty); DOWN=$(param down); UP=$(param up); MINS=$(param mins)
	is_num "$QTY" || err "Quantity required"
	[ "$QTY" -ge 1 ] || err "Quantity must be at least 1"
	[ "$QTY" -le 1000 ] || err "Maximum 1000 at a time"
	is_num "$DOWN" || DOWN=0
	is_num "$UP" || UP=0
	is_num "$MINS" || err "Validity minutes required"
	[ "$MINS" -gt 0 ] || err "Validity must be more than 0 minutes"
	PRICE=$(param price)
	is_num "$PRICE" || PRICE=0
	LIST=""
	i=0
	while [ "$i" -lt "$QTY" ]; do
		C=$(gencode)
		grep -q "^$C," "$VFILE" && continue
		printf '%s,%s,%s,0,0,%s,0\n' "$C" "$DOWN" "$UP" "$MINS" >> "$VFILE"
		[ "$PRICE" -gt 0 ] && printf '%s,%s\n' "$C" "$PRICE" >> "$PRFILE"
		[ -n "$LIST" ] && LIST="$LIST,"
		LIST="$LIST\"$C\""
		i=$((i+1))
	done
	jhdr; printf '{"ok":1,"codes":[%s]}' "$LIST"
	exit 0;;

vdel)
	CODE=$(param code | tr 'a-z' 'A-Z')
	is_code "$CODE" || err "Bad code"
	sed -i "/^$CODE,/d" "$VFILE"
	sed -i "/^$CODE,/d" "$PRFILE" 2>/dev/null
	okj;;

vreset)
	CODE=$(param code | tr 'a-z' 'A-Z' | tr -d ' ')
	is_code "$CODE" || err "Code must be 9 letters/numbers"
	grep -q "^$CODE," "$VFILE" || err "Code not found"
	awk -F',' -v c="$CODE" 'BEGIN{OFS=","} {if($1==c){$7=0} print}' "$VFILE" > "$VFILE.tmp" && mv "$VFILE.tmp" "$VFILE"
	okj;;

clients)
	jhdr
	ndsctl json 2>/dev/null || printf '{"clients":{}}'
	exit 0;;

deauth)
	MAC=$(param mac)
	is_mac "$MAC" || err "Invalid MAC address"
	ndsctl deauth "$MAC" >/dev/null 2>&1
	okj;;

wl_list)
	V=$(uci -q get opennds.@opennds[0].trustedmac 2>/dev/null)
	jhdr; printf '{"ok":1,"macs":['
	first=1
	for m in $V; do
		[ "$first" = "1" ] && first=0 || printf ','
		printf '"%s"' "$m"
	done
	printf ']}'
	exit 0;;

wl_add)
	MAC=$(param mac)
	is_mac "$MAC" || err "Invalid MAC (format AA:BB:CC:DD:EE:FF)"
	uci -q add_list opennds.@opennds[0].trustedmac="$MAC"
	uci -q commit opennds
	ndsctl trust "$MAC" >/dev/null 2>&1
	okj;;

wl_del)
	MAC=$(param mac)
	is_mac "$MAC" || err "Invalid MAC"
	uci -q del_list opennds.@opennds[0].trustedmac="$MAC"
	uci -q commit opennds
	ndsctl untrust "$MAC" >/dev/null 2>&1
	okj;;

bw)
	L=$(grep "$LANIF:" /proc/net/dev 2>/dev/null | head -n1 | tr ':' ' ')
	RX=$(printf '%s' "$L" | awk '{print $2}')
	TX=$(printf '%s' "$L" | awk '{print $10}')
	jhdr; printf '{"ok":1,"rx":%s,"tx":%s,"t":%s}' "${RX:-0}" "${TX:-0}" "$(date +%s)"
	exit 0;;

backup)
	printf 'Content-type: application/octet-stream\r\nContent-Disposition: attachment; filename="shamim-vouchers-backup.txt"\r\n\r\n'
	cat "$VFILE"
	exit 0;;

restore)
	DATA=$(param data)
	printf '%s\n' "$DATA" | tr -d '\r' | grep -E '^[A-Za-z0-9-]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+,[0-9]+$' > "$VFILE.tmp"
	N=$(grep -c . "$VFILE.tmp")
	if [ "$N" -gt 0 ] 2>/dev/null; then
		mv "$VFILE.tmp" "$VFILE"
		jhdr; printf '{"ok":1,"count":%s}' "$N"
	else
		rm -f "$VFILE.tmp"
		err "No valid voucher lines found in pasted text"
	fi
	exit 0;;

chpass)
	NID=$(param nid); NPW=$(param npw)
	printf '%s' "$NID" | grep -qE '^[A-Za-z0-9_-]{3,32}$' || err "Router ID: 3-32 letters/numbers"
	[ "${#NPW}" -ge 6 ] || err "Password minimum 6 characters"
	printf '%s' "$NPW" | grep -qE '^[A-Za-z0-9@#%._-]+$' || err "Password: letters, numbers and @ # % . _ - only"
	ADMIN_ID="$NID"; ADMIN_PW="$NPW"
	write_cfg
	okj;;

setcfg)
	NBRAND=$(param brand); NIF=$(param lanif)
	printf '%s' "$NBRAND" | grep -qE '^[A-Za-z0-9 ._-]{1,30}$' || err "Brand: 1-30 letters/numbers/spaces"
	printf '%s' "$NIF" | grep -qE '^[A-Za-z0-9._-]{1,20}$' || err "Interface name invalid"
	LANIF="$NIF"; BRAND="$NBRAND"
	write_cfg
	okj;;

cfg_all)
	jhdr
	printf '{"ok":1,"brand":"%s","lanif":"%s","tg_token":"%s","tg_chat":"%s","bkash":"%s","nagad":"%s","paynote":"%s","pmsg":"%s","rb_type":"%s","rb_hh":%s,"rb_mm":%s,"ver":"%s"}' \
		"$(jesc "$BRAND")" "$(jesc "$LANIF")" "$(jesc "$TG_TOKEN")" "$(jesc "$TG_CHAT")" "$(jesc "$PAY_BKASH")" "$(jesc "$PAY_NAGAD")" "$(jesc "$PAY_NOTE")" "$(jesc "$PORTAL_MSG")" "$RB_TYPE" "${RB_HH:-4}" "${RB_MM:-0}" "$VERSION"
	exit 0;;

pk_list)
	jhdr; printf '{"ok":1,"p":['
	awk -F'|' 'NF>=5{printf "%s[\"%s\",%d,%d,%d,%d]", (c++?",":""), $1,$2,$3,$4,$5}' "$PKFILE" 2>/dev/null
	printf ']}'
	exit 0;;

pk_add)
	NM=$(param name); PR=$(param price); DOWN=$(param down); UP=$(param up); MINS=$(param mins)
	printf '%s' "$NM" | grep -qE '^[A-Za-z0-9 ._-]{1,24}$' || err "Package name: 1-24 letters/numbers/spaces"
	is_num "$PR" || err "Price must be a number (Taka)"
	is_num "$DOWN" || DOWN=0
	is_num "$UP" || UP=0
	is_num "$MINS" || err "Validity minutes required"
	[ "$MINS" -gt 0 ] || err "Validity must be more than 0"
	grep -q "^$NM|" "$PKFILE" 2>/dev/null && err "Package name already exists"
	printf '%s|%s|%s|%s|%s\n' "$NM" "$PR" "$DOWN" "$UP" "$MINS" >> "$PKFILE"
	okj;;

pk_del)
	NM=$(param name)
	[ -n "$NM" ] || err "Package name required"
	grep -v "^$NM|" "$PKFILE" > "$PKFILE.tmp" 2>/dev/null
	mv "$PKFILE.tmp" "$PKFILE"
	okj;;

insights)
	NOW=$(date +%s)
	E=$(awk -F',' -v now="$NOW" -v pf="$PRFILE" 'FILENAME==pf{if(NF>=2)pr[$1]=$2;next} NF>=7 && $7>0 {used++; earn+=pr[$1]; if(now-$7<604800)e7+=pr[$1]; if(now-$7<2592000)e30+=pr[$1]} END{printf "%d %d %d %d", earn+0,e7+0,e30+0,used+0}' "$PRFILE" "$VFILE")
	set -- $E
	jhdr
	printf '{"ok":1,"earn":%s,"e7":%s,"e30":%s,"used":%s,"r":[' "${1:-0}" "${2:-0}" "${3:-0}" "${4:-0}"
	awk -F',' -v pf="$PRFILE" 'FILENAME==pf{if(NF>=2)pr[$1]=$2;next} NF>=7 && $7>0 {print $7","$1","(pr[$1]+0)","$6}' "$PRFILE" "$VFILE" | sort -t',' -k1,1nr | head -n 12 | awk -F',' '{printf "%s[%d,\"%s\",%d,%d]", (c++?",":""), $1,$2,$3,$4}'
	printf ']}'
	exit 0;;

tg_set)
	T=$(param token); C=$(param chat)
	printf '%s' "$T" | grep -qE '^[A-Za-z0-9:_-]{0,64}$' || err "Bot token: invalid characters"
	printf '%s' "$C" | grep -qE '^-?[0-9]{0,20}$' || err "Chat ID must be a number"
	TG_TOKEN="$T"; TG_CHAT="$C"
	write_cfg
	okj;;

tg_test)
	[ -n "$TG_TOKEN" ] && [ -n "$TG_CHAT" ] || err "Save bot token and chat ID first"
	R=$(wget -qO- "https://api.telegram.org/bot$TG_TOKEN/sendMessage?chat_id=$TG_CHAT&text=Panel%20test%20OK" 2>/dev/null)
	case "$R" in
	*'"ok":true'*) okj;;
	*) err "Telegram not reachable - check token, chat ID and internet";;
	esac
	;;

pay_set)
	B=$(param bkash); N=$(param nagad); NT=$(param note)
	printf '%s' "$B" | grep -qE '^[0-9+ -]{0,20}$' || err "bKash number: digits only"
	printf '%s' "$N" | grep -qE '^[0-9+ -]{0,20}$' || err "Nagad number: digits only"
	printf '%s' "$NT" | grep -qE '^[A-Za-z0-9 .,!?_-]{0,120}$' || err "Note: English letters/numbers only (max 120)"
	PAY_BKASH="$B"; PAY_NAGAD="$N"; PAY_NOTE="$NT"
	write_cfg
	okj;;

theme_set)
	M=$(param msg)
	printf '%s' "$M" | grep -qE '^[A-Za-z0-9 .,!?_-]{0,120}$' || err "Message: English letters/numbers only (max 120)"
	PORTAL_MSG="$M"
	write_cfg
	okj;;

cron_set)
	TY=$(param type); HH=$(param hh); MM=$(param mm)
	case "$TY" in disabled|daily) : ;; *) err "Schedule type invalid";; esac
	is_num "$HH" && [ "$HH" -le 23 ] || err "Hour must be 0-23"
	is_num "$MM" && [ "$MM" -le 59 ] || err "Minute must be 0-59"
	RB_TYPE="$TY"; RB_HH="$HH"; RB_MM="$MM"
	write_cfg
	touch "$CRONF" 2>/dev/null
	grep -v 'SHAMIM_AUTOREBOOT' "$CRONF" > "$CRONF.tmp" 2>/dev/null
	[ "$TY" = "daily" ] && printf '%s %s * * * /sbin/reboot # SHAMIM_AUTOREBOOT\n' "$MM" "$HH" >> "$CRONF.tmp"
	mv "$CRONF.tmp" "$CRONF"
	/etc/init.d/cron restart >/dev/null 2>&1
	okj;;

factory_reset)
	jhdr; printf '{"ok":1}'
	( sleep 2; firstboot -y; reboot ) >/dev/null 2>&1 &
	exit 0;;

reboot_now)
	jhdr; printf '{"ok":1}'
	( sleep 2; reboot ) >/dev/null 2>&1 &
	exit 0;;

restart_nds)
	jhdr; printf '{"ok":1}'
	( sleep 1; /etc/init.d/opennds restart ) >/dev/null 2>&1 &
	exit 0;;

"") : ;;

*)
	err "Unknown action";;
esac

# ---------- default: serve the app ----------
printf 'Content-type: text/html\r\n\r\n'
cat <<'PAGEEOF'
