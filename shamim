	'.vcode{font-family:monospace;font-size:17px;font-weight:800;letter-spacing:2px;border:1.4px solid #222;border-radius:6px;padding:5px 2px;margin-bottom:5px}'+
	'.vm{font-size:9px;color:#333}'+
	'.vf{font-size:8px;color:#777;margin-top:4px}'+
	'.vn{position:absolute;top:3px;right:6px;font-size:8px;color:#aaa}'+
	'@media print{.noprint{display:none}}'+
	'</style></head><body><div class="noprint" style="margin-bottom:8px"><button onclick="window.print()">Print</button></div><div class="wrap">'+cards+'</div></body></html>');
	w.document.close();
	setTimeout(function(){ try{w.print();}catch(e){} },400);
}

