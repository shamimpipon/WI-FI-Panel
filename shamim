function printUnused(){
	var codes=[],meta={};
	VDATA.forEach(function(v){ if(+v[6]===0){ codes.push(v[0]); meta[v[0]]=v; } });
	if(!codes.length) return toast('No unused vouchers to print',true);
	printCodes(codes);
}
function findV(c){ for(var i=0;i<VDATA.length;i++) if(VDATA[i][0]===c) return VDATA[i]; return null; }
function printCodes(codes){
	var price=$('vPrice')?$('vPrice').value.trim():'';
	var cards='';
	codes.forEach(function(c,i){
		var v=findV(c), sp=v?fmtSpeed(v[1]):'', du=v?fmtDur(v[5]):'';
		cards+='<div class="vc"><div class="vb">'+esc(BRAND)+'</div><div class="vt">WiFi VOUCHER '+(price?'&#8226; '+esc(price):'')+'</div>'+
		'<div class="vcode">'+esc(c)+'</div>'+
		'<div class="vm">'+(sp?'Speed: '+sp+' &nbsp;&#8226;&nbsp; ':'')+(du?'Validity: '+du:'')+'</div>'+
		'<div class="vf">Connect to WiFi &#8594; enter this code &#8594; enjoy!</div><div class="vn">#'+(i+1)+'</div></div>';
	});
	var w=window.open('','_blank');
	w.document.write('<!DOCTYPE html><html><head><meta charset="UTF-8"><title>'+esc(BRAND)+' Vouchers</title><style>'+
	'body{font-family:Arial,sans-serif;margin:8mm}'+
	'.wrap{display:grid;grid-template-columns:repeat(4,1fr);gap:4mm}'+
	'.vc{border:1.6px dashed #666;border-radius:8px;padding:9px 8px;text-align:center;page-break-inside:avoid;position:relative}'+
	'.vb{font-weight:800;font-size:12px;color:#0e6ea8}'+
