/* ---------- bandwidth graph ---------- */
var bwPrev=null,bwD=[],bwU=[];
function pollBw(){
	api('bw').then(function(b){
		if(bwPrev && b.t>bwPrev.t){
			var dt=b.t-bwPrev.t;
			bwD.push(Math.max(0,(b.rx-bwPrev.rx)*8/dt/1e6));
			bwU.push(Math.max(0,(b.tx-bwPrev.tx)*8/dt/1e6));
			if(bwD.length>45){bwD.shift();bwU.shift();}
			drawBw();
		}
		bwPrev=b;
	}).catch(function(){});
}
function drawBw(){
	var cv=$('bwCanvas'); if(!cv) return;
	cv.width=cv.clientWidth||800;
	var w=cv.width,h=cv.height,ctx=cv.getContext('2d');
	ctx.clearRect(0,0,w,h);
	var mx=0.5; bwD.concat(bwU).forEach(function(v){ if(v>mx)mx=v; });
	ctx.strokeStyle='#e4f0f6'; ctx.fillStyle='#8fb3c5'; ctx.font='10px sans-serif';
	for(var g=0;g<=4;g++){ var y=h-8-(h-24)*g/4;
		ctx.beginPath(); ctx.moveTo(34,y); ctx.lineTo(w-4,y); ctx.stroke();
		ctx.fillText((mx*g/4).toFixed(1),2,y+3); }
	function line(arr,col){
		if(arr.length<2) return;
		ctx.strokeStyle=col; ctx.lineWidth=2; ctx.beginPath();
		arr.forEach(function(v,i){
			var x=34+(w-40)*i/(45-1), y=h-8-(h-24)*(v/mx);
			i?ctx.lineTo(x,y):ctx.moveTo(x,y);
		});
		ctx.stroke();
	}
	line(bwD,'#7cc74f'); line(bwU,'#3aa4d8');
}

